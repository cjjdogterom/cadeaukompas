# Kopieer naar .env.local en vul in. NOOIT .env.local committen.
# Zie ops/owner-todo.md voor waar je elke sleutel aanmaakt.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Eigenaar-dashboard /admin (Basic Auth). Zonder wachtwoord alleen bereikbaar via `npm run dev`.
ADMIN_PASSWORD=

# Affiliate
NEXT_PUBLIC_BOL_SITE_ID=
NEXT_PUBLIC_AMAZON_TAG=
BOL_API_CLIENT_ID=
BOL_API_CLIENT_SECRET=
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
TRADETRACKER_CUSTOMER_ID=
TRADETRACKER_PASSPHRASE=
TRADETRACKER_SITE_ID=
DAISYCON_PUBLISHER_ID=
DAISYCON_MEDIA_ID=

# Database (Supabase, regio eu-central-1) — optioneel: klikregistratie /uit. Zonder Supabase werkt de site gewoon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics (pas laden na toestemming)
NEXT_PUBLIC_GA4_ID=
GA4_API_SECRET=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
NEXT_PUBLIC_PINTEREST_TAG_ID=
